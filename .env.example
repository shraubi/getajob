# Required
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
ANTHROPIC_API_KEY=sk-ant-api03-...
YOUR_CHAT_ID=123456789

# Model routing (defaults shown — swap for OpenAI models if OPENAI_API_KEY is set)
SCORE_MODEL=claude-haiku-4-5-20251001
GENERATE_MODEL=claude-sonnet-4-6
SCORE_THRESHOLD=6

# Optional: enables GPT models and text-embedding-3-small for RAG
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small

# RAG storage path (created automatically)
CHROMA_DIR=storage/chroma_db

